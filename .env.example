# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=your-gemini-api-key

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE DATABASE CONFIGURATION
# ==============================================================================
# Retrieve these credentials from your Supabase Project Dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project -> Project Settings -> API
# 3. Copy the Project URL and Project API Anon Key below:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional Server-side / Service Key (for administrative scripts)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
