{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user identity and clinical demographics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 180 },
        "role": { "type": "string", "enum": ["patient", "doctor", "receptionist", "admin"] },
        "pid": { "type": "string", "minLength": 3, "maxLength": 32 },
        "phone": { "type": "string", "maxLength": 32 },
        "dob": { "type": "string", "maxLength": 32 },
        "bloodGroup": { "type": "string", "maxLength": 32 },
        "emergencyContact": { "type": "string", "maxLength": 120 },
        "insuranceProvider": { "type": "string", "maxLength": 120 },
        "policyId": { "type": "string", "maxLength": 64 },
        "allergies": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "pid", "createdAt", "updatedAt"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Board-certified physician directory record.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "credentials": { "type": "string", "minLength": 2, "maxLength": 40 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 80 },
        "department": { "type": "string", "minLength": 2, "maxLength": 80 },
        "hospital": { "type": "string", "minLength": 2, "maxLength": 160 },
        "npi": { "type": "string", "minLength": 4, "maxLength": 24 },
        "license": { "type": "string", "minLength": 2, "maxLength": 40 },
        "experienceYears": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "consultationsCount": { "type": "number" },
        "baseFee": { "type": "number" },
        "copayFee": { "type": "number" },
        "dutyStatus": { "type": "string", "enum": ["In Consultation", "On Duty", "Off Duty"] },
        "telehealthReady": { "type": "boolean" },
        "inClinicReady": { "type": "boolean" },
        "availableToday": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "bio": { "type": "string", "maxLength": 1200 },
        "languages": { "type": "array" },
        "acceptedInsurance": { "type": "array" },
        "nextSlots": { "type": "array" },
        "avatarKey": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "credentials", "specialty", "department", "hospital", "npi", "copayFee", "baseFee", "dutyStatus", "isActive", "createdAt", "updatedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Hospital clinical department and unit capacity.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "headDoctor": { "type": "string", "minLength": 2, "maxLength": 120 },
        "totalDoctors": { "type": "number" },
        "activePatients": { "type": "number" },
        "todaysAppointments": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "headDoctor", "totalDoctors", "activePatients", "todaysAppointments", "isActive", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinical consultation booking and intake dossier.",
      "type": "object",
      "properties": {
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patientPid": { "type": "string", "minLength": 3, "maxLength": 32 },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "doctorCredentials": { "type": "string", "maxLength": 40 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 80 },
        "department": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "minLength": 2, "maxLength": 180 },
        "visitMode": { "type": "string", "enum": ["in-person", "telehealth"] },
        "appointmentDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "appointmentTime": { "type": "string", "minLength": 3, "maxLength": 32 },
        "durationMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["scheduled", "checked-in", "in-exam", "completed", "cancelled"] },
        "chiefComplaint": { "type": "string", "minLength": 2, "maxLength": 120 },
        "symptomDuration": { "type": "string", "maxLength": 60 },
        "symptomDescription": { "type": "string", "maxLength": 600 },
        "riskFactors": { "type": "array" },
        "attachedDocumentName": { "type": "string", "maxLength": 160 },
        "insuranceProvider": { "type": "string", "maxLength": 120 },
        "policyId": { "type": "string", "maxLength": 64 },
        "standardFee": { "type": "number" },
        "insurerCoverage": { "type": "number" },
        "copayAmount": { "type": "number" },
        "copayPaid": { "type": "boolean" },
        "receiptNumber": { "type": "string", "maxLength": 40 },
        "roomNumber": { "type": "string", "maxLength": 32 },
        "physicianSummary": { "type": "string", "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientUid", "patientName", "patientPid", "doctorId", "doctorName", "specialty", "location", "visitMode", "appointmentDate", "appointmentTime", "status", "chiefComplaint", "copayAmount", "copayPaid", "createdAt", "updatedAt"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Active medication and refill status.",
      "type": "object",
      "properties": {
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dosage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "frequency": { "type": "string", "maxLength": 80 },
        "prescriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "pharmacy": { "type": "string", "maxLength": 120 },
        "refillsRemaining": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "refill-requested", "approved", "completed"] },
        "lastFilledDate": { "type": "string", "maxLength": 40 },
        "nextRefillDue": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientUid", "medicationName", "dosage", "prescriberName", "refillsRemaining", "status", "createdAt", "updatedAt"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Verified lab report, imaging, or clinical upload.",
      "type": "object",
      "properties": {
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "providerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dateLabel": { "type": "string", "minLength": 2, "maxLength": 40 },
        "status": { "type": "string", "enum": ["normal", "attention", "critical", "pending"] },
        "summary": { "type": "string", "minLength": 2, "maxLength": 600 },
        "metrics": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientUid", "title", "category", "providerName", "dateLabel", "status", "summary", "createdAt", "updatedAt"]
    },
    "AiConsultationMessage": {
      "title": "AiConsultationMessage",
      "description": "Dr. Nova AI Health Assistant clinical triage message.",
      "type": "object",
      "properties": {
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "severity": { "type": "string", "maxLength": 40 },
        "triagePriority": { "type": "string", "maxLength": 80 },
        "icd10Code": { "type": "string", "maxLength": 32 },
        "observations": { "type": "array" },
        "protocol": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientUid", "sender", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Authenticated user profile and clinical demographics isolated by userId."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Trusted administrator lookup directory."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "Doctor" },
      "description": "Public hospital directory of accredited physicians."
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "Department" },
      "description": "Active clinical departments and operational capacities."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "Appointment" },
      "description": "Patient clinical appointments and intake records."
    },
    "/prescriptions/{prescriptionId}": {
      "schema": { "$ref": "Prescription" },
      "description": "Patient active prescriptions and refill requests."
    },
    "/medicalRecords/{recordId}": {
      "schema": { "$ref": "MedicalRecord" },
      "description": "Patient lab reports, ECG strips, and diagnostic records."
    },
    "/aiConsultations/{messageId}": {
      "schema": { "$ref": "AiConsultationMessage" },
      "description": "Persistent clinical triage chat messages with Dr. Nova AI."
    }
  }
}
