rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Global Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'keerthikas25bcg027@skasc.ac.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringArray(arr, maxItems, maxItemLen) {
      return arr is list && arr.size() <= maxItems && (
        arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen)
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'pid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'pid', 'phone', 'dob',
          'bloodGroup', 'emergencyContact', 'insuranceProvider', 'policyId',
          'allergies', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.role in ['patient', 'doctor', 'receptionist', 'admin']
        && data.pid is string && data.pid.size() >= 3 && data.pid.size() <= 32
        && isValidOptionalString(data, 'phone', 32)
        && isValidOptionalString(data, 'dob', 32)
        && isValidOptionalString(data, 'bloodGroup', 32)
        && isValidOptionalString(data, 'emergencyContact', 120)
        && isValidOptionalString(data, 'insuranceProvider', 120)
        && isValidOptionalString(data, 'policyId', 64)
        && isValidOptionalString(data, 'allergies', 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll([
        'name', 'credentials', 'specialty', 'department', 'hospital',
        'npi', 'copayFee', 'baseFee', 'dutyStatus', 'isActive', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'name', 'credentials', 'specialty', 'department', 'hospital', 'npi', 'license',
        'experienceYears', 'rating', 'reviewCount', 'consultationsCount', 'baseFee', 'copayFee',
        'dutyStatus', 'telehealthReady', 'inClinicReady', 'availableToday', 'isActive',
        'bio', 'languages', 'acceptedInsurance', 'nextSlots', 'avatarKey', 'createdAt', 'updatedAt'
      ])
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
      && data.credentials is string && data.credentials.size() >= 2 && data.credentials.size() <= 40
      && data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 80
      && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
      && data.hospital is string && data.hospital.size() >= 2 && data.hospital.size() <= 160
      && data.npi is string && data.npi.size() >= 4 && data.npi.size() <= 24
      && isValidOptionalString(data, 'license', 40)
      && isValidOptionalString(data, 'bio', 1200)
      && isValidOptionalString(data, 'avatarKey', 64)
      && data.copayFee is number && data.copayFee >= 0 && data.copayFee <= 10000
      && data.baseFee is number && data.baseFee >= 0 && data.baseFee <= 10000
      && data.dutyStatus in ['In Consultation', 'On Duty', 'Off Duty']
      && data.isActive is bool
      && (!('telehealthReady' in data) || data.telehealthReady is bool)
      && (!('inClinicReady' in data) || data.inClinicReady is bool)
      && (!('availableToday' in data) || data.availableToday is bool)
      && (!('experienceYears' in data) || data.experienceYears is number)
      && (!('rating' in data) || data.rating is number)
      && (!('reviewCount' in data) || data.reviewCount is number)
      && (!('consultationsCount' in data) || data.consultationsCount is number)
      && (!('languages' in data) || isValidStringArray(data.languages, 10, 40))
      && (!('acceptedInsurance' in data) || isValidStringArray(data.acceptedInsurance, 10, 60))
      && (!('nextSlots' in data) || isValidStringArray(data.nextSlots, 12, 40))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll([
        'name', 'headDoctor', 'totalDoctors', 'activePatients', 'todaysAppointments', 'isActive', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'name', 'headDoctor', 'totalDoctors', 'activePatients', 'todaysAppointments', 'isActive', 'createdAt', 'updatedAt'
      ])
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
      && data.headDoctor is string && data.headDoctor.size() >= 2 && data.headDoctor.size() <= 120
      && data.totalDoctors is number && data.totalDoctors >= 0
      && data.activePatients is number && data.activePatients >= 0
      && data.todaysAppointments is number && data.todaysAppointments >= 0
      && data.isActive is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
        'patientUid', 'patientName', 'patientPid', 'doctorId', 'doctorName',
        'specialty', 'location', 'visitMode', 'appointmentDate', 'appointmentTime',
        'status', 'chiefComplaint', 'copayAmount', 'copayPaid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'patientUid', 'patientName', 'patientPid', 'doctorId', 'doctorName', 'doctorCredentials',
        'specialty', 'department', 'location', 'visitMode', 'appointmentDate', 'appointmentTime',
        'durationMinutes', 'status', 'chiefComplaint', 'symptomDuration', 'symptomDescription',
        'riskFactors', 'attachedDocumentName', 'insuranceProvider', 'policyId',
        'standardFee', 'insurerCoverage', 'copayAmount', 'copayPaid', 'receiptNumber',
        'roomNumber', 'physicianSummary', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.patientUid)
      && isValidId(data.doctorId)
      && data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 120
      && data.patientPid is string && data.patientPid.size() >= 3 && data.patientPid.size() <= 32
      && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 120
      && data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 80
      && data.location is string && data.location.size() >= 2 && data.location.size() <= 180
      && data.visitMode in ['in-person', 'telehealth']
      && data.appointmentDate is string && data.appointmentDate.size() >= 4 && data.appointmentDate.size() <= 40
      && data.appointmentTime is string && data.appointmentTime.size() >= 3 && data.appointmentTime.size() <= 32
      && data.status in ['scheduled', 'checked-in', 'in-exam', 'completed', 'cancelled']
      && data.chiefComplaint is string && data.chiefComplaint.size() >= 2 && data.chiefComplaint.size() <= 120
      && data.copayAmount is number && data.copayAmount >= 0 && data.copayAmount <= 10000
      && data.copayPaid is bool
      && isValidOptionalString(data, 'doctorCredentials', 40)
      && isValidOptionalString(data, 'department', 80)
      && isValidOptionalString(data, 'symptomDuration', 60)
      && isValidOptionalString(data, 'symptomDescription', 600)
      && isValidOptionalString(data, 'attachedDocumentName', 160)
      && isValidOptionalString(data, 'insuranceProvider', 120)
      && isValidOptionalString(data, 'policyId', 64)
      && isValidOptionalString(data, 'receiptNumber', 40)
      && isValidOptionalString(data, 'roomNumber', 32)
      && isValidOptionalString(data, 'physicianSummary', 800)
      && (!('durationMinutes' in data) || data.durationMinutes is number)
      && (!('standardFee' in data) || data.standardFee is number)
      && (!('insurerCoverage' in data) || data.insurerCoverage is number)
      && (!('riskFactors' in data) || isValidStringArray(data.riskFactors, 10, 80))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPrescription(data) {
      return data.keys().hasAll([
        'patientUid', 'medicationName', 'dosage', 'prescriberName',
        'refillsRemaining', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'patientUid', 'medicationName', 'dosage', 'frequency', 'prescriberName',
        'pharmacy', 'refillsRemaining', 'status', 'lastFilledDate', 'nextRefillDue',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.patientUid)
      && data.medicationName is string && data.medicationName.size() >= 2 && data.medicationName.size() <= 120
      && data.dosage is string && data.dosage.size() >= 1 && data.dosage.size() <= 80
      && data.prescriberName is string && data.prescriberName.size() >= 2 && data.prescriberName.size() <= 120
      && data.refillsRemaining is number && data.refillsRemaining >= 0 && data.refillsRemaining <= 99
      && data.status in ['active', 'refill-requested', 'approved', 'completed']
      && isValidOptionalString(data, 'frequency', 80)
      && isValidOptionalString(data, 'pharmacy', 120)
      && isValidOptionalString(data, 'lastFilledDate', 40)
      && isValidOptionalString(data, 'nextRefillDue', 40)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMedicalRecord(data) {
      return data.keys().hasAll([
        'patientUid', 'title', 'category', 'providerName', 'dateLabel', 'status', 'summary', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'patientUid', 'title', 'category', 'providerName', 'dateLabel', 'status', 'summary', 'metrics', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.patientUid)
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
      && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
      && data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 120
      && data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 40
      && data.status in ['normal', 'attention', 'critical', 'pending']
      && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 600
      && (!('metrics' in data) || isValidStringArray(data.metrics, 8, 80))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAiMessage(data) {
      return data.keys().hasAll(['patientUid', 'sender', 'content', 'createdAt'])
      && data.keys().hasOnly([
        'patientUid', 'sender', 'content', 'severity', 'triagePriority',
        'icd10Code', 'observations', 'protocol', 'createdAt'
      ])
      && isValidId(data.patientUid)
      && data.sender in ['user', 'assistant']
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
      && isValidOptionalString(data, 'severity', 40)
      && isValidOptionalString(data, 'triagePriority', 80)
      && isValidOptionalString(data, 'icd10Code', 32)
      && (!('observations' in data) || isValidStringArray(data.observations, 8, 240))
      && (!('protocol' in data) || isValidStringArray(data.protocol, 8, 240))
      && data.createdAt is timestamp;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && (incoming().role == 'patient' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'phone', 'dob', 'bloodGroup', 'emergencyContact',
              'insuranceProvider', 'policyId', 'allergies', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list, write: if false;
    }

    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId) && (resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'credentials', 'specialty', 'department', 'hospital', 'license',
          'experienceYears', 'rating', 'reviewCount', 'consultationsCount', 'baseFee',
          'copayFee', 'dutyStatus', 'telehealthReady', 'inClinicReady', 'availableToday',
          'isActive', 'bio', 'languages', 'acceptedInsurance', 'nextSlots', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow get: if isValidId(departmentId) && (resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(departmentId)
        && isValidDepartment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(departmentId)
        && isValidDepartment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'headDoctor', 'totalDoctors', 'activePatients', 'todaysAppointments', 'isActive', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && (incoming().patientUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/doctors/$(incoming().doctorId));
      allow update: if isVerifiedUser()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().patientUid == existing().patientUid
        && incoming().doctorId == existing().doctorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().patientUid == request.auth.uid
            && existing().status != 'completed'
            && existing().status != 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'appointmentDate', 'appointmentTime', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      allow get: if isValidId(prescriptionId) && isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(prescriptionId)
        && isValidPrescription(incoming())
        && (incoming().patientUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(prescriptionId)
        && isValidPrescription(incoming())
        && incoming().patientUid == existing().patientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().patientUid == request.auth.uid
            && existing().status == 'active'
            && incoming().status == 'refill-requested'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /medicalRecords/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(recordId)
        && isValidMedicalRecord(incoming())
        && (
          isAdmin() ||
          (incoming().patientUid == request.auth.uid && incoming().category == 'Patient Upload')
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(recordId)
        && isValidMedicalRecord(incoming())
        && incoming().patientUid == existing().patientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'summary', 'metrics', 'updatedAt']);
      allow delete: if false;
    }

    match /aiConsultations/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidAiMessage(incoming())
        && incoming().patientUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
